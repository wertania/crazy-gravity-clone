# Keep the build context small and the build reproducible. Anything that the
# image builds for itself, or that only exists on a developer machine, stays
# out - a stale local `dist` or a node_modules built for another platform
# leaking into the image is the classic "works here, not there".

.git
.gitignore
node_modules
dist
.vite

# Test output and the screenshots the Playwright suite writes.
test-results
playwright-report
shots
screenshots
*.log

# Editor and OS litter.
.vscode
.idea
.DS_Store

# Docs and licence text do not belong in a static-file image. The source it
# builds from does: `npm run build` type-checks `tests` and
# `playwright.config.ts` as well as `src`, so those must stay in the context.
README.md
LICENSE
Dockerfile
.dockerignore
docker-compose.yml
